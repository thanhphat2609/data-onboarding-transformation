# Copy to .env (git-ignored) and load it before running dbt. In Codespaces, use Codespaces secrets instead.

# local = lake on disk under .lake/ ; azure = ADLS Gen2 with az login / service principal ;
# azure_key = ADLS Gen2 with the account key below (azure:// paths)
DBT_TARGET=azure

# Storage account of the lake (same one data-onboarding-ingestion writes to)
ADLS_STORAGE_ACCOUNT=stdatalakedev

# Raw Parquet landed by ingestion, and where curated Parquet is written
LAKE_RAW_ROOT=abfss://raw@stdatalakedev.dfs.core.windows.net/parquet
LAKE_CURATED_ROOT=abfss://transformation@stdatalakedev.dfs.core.windows.net/dbt

# Account key, same secret name as everywhere else (GitHub secret ADLS_ACCOUNT_KEY). Only for DBT_TARGET=azure_key.
ADLS_ACCOUNT_KEY=

# Auth: leave empty to use your Azure CLI login (az login). For CI, a service principal
# with "Storage Blob Data Reader" on raw and "Storage Blob Data Contributor" on curated:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
